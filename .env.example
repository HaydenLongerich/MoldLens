# Copy to .env. Keys stay on the server; never use VITE_* for secrets.
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4.1
OPENAI_TEXT_MODEL=gpt-4.1

# Alternative: AI_PROVIDER=anthropic, plus models available to your account.
# ANTHROPIC_API_KEY=
# AI_VISION_MODEL=
# AI_TEXT_MODEL=
# AI_PROVIDER=mock is an explicitly labeled demo, not a real detector.

# Defaults: persistent PGlite database and private files under data/.
# MOLDLENS_DATA_DIR=/absolute/path/to/moldlens-data
# SCREENING_DATABASE_URL=postgresql://user:password@localhost:5432/moldlens
# PORT=5173

# Optional binaries; otherwise ffmpeg-static/ffprobe-static are used.
# FFMPEG_PATH=/absolute/path/to/ffmpeg
# FFPROBE_PATH=/absolute/path/to/ffprobe

# Limits for screening uploads (separate from the manual review form).
MEDIA_MAX_UPLOAD_BYTES=524288000
MEDIA_MAX_VIDEO_SECONDS=600
MEDIA_FRAME_INTERVAL_SECONDS=2
AI_MAX_FRAMES_PER_RUN=12
# Estimated-cost warning threshold per run, NOT a spending cap.
AI_BUDGET_USD_PER_RUN=1.5
# Optional estimate overrides; check your provider's current pricing.
# OPENAI_PRICE_INPUT_PER_MTOK=
# OPENAI_PRICE_OUTPUT_PER_MTOK=

# Ontario contractor search: enable Places API (New) and Geocoding API.
# Restrict this server key by API and deployment IP; configure Google billing quotas.
GOOGLE_MAPS_API_KEY=

# Preview is the default: durable invitations are visible in company settings,
# with no network email delivery. Live requires every setting below.
MOLDLENS_EMAIL_MODE=preview
RESEND_API_KEY=
# Must be a sender on your verified Resend domain.
MOLDLENS_EMAIL_FROM=
# Set your public HTTPS origin before enabling live emails.
MOLDLENS_PUBLIC_URL=http://127.0.0.1:5173
