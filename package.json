{
  "name": "moldlens",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/build-screening.mjs && node --env-file-if-exists=.env server/index.mjs",
    "build": "node scripts/build-screening.mjs && tsc -b && vite build && node scripts/build-offline.mjs",
    "start": "NODE_ENV=production node --env-file-if-exists=.env server/index.mjs",
    "test": "node scripts/build-screening.mjs && node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "test:offline": "playwright test --config=playwright.offline.config.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "@electric-sql/pglite": "0.2.17",
    "busboy": "1.6.0",
    "drizzle-orm": "0.38.4",
    "express": "4.18.2",
    "ffmpeg-static": "5.3.0",
    "ffprobe-static": "3.1.0",
    "lucide-react": "0.460.0",
    "openai": "7.43.0",
    "pg": "8.23.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "sharp": "0.33.5",
    "three": "0.186.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "20.19.43",
    "@types/react": "18.3.20",
    "@types/react-dom": "18.3.6",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "4.3.4",
    "esbuild": "0.25.2",
    "typescript": "5.8.3",
    "vite": "6.2.5"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
